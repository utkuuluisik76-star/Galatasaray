{
  "name": "galatasaray-fan-concept",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-29",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media/stadium-drone.mp4"] },
  "d1_databases": [{ "binding": "DB", "database_name": "galatasaray-community", "database_id": "TO_CONFIRM_DATABASE_ID", "migrations_dir": "server/migrations" }],
  "observability": { "enabled": false }
}
